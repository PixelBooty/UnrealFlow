# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
!Sync/UnrealFlowSync/*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/*/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/*/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*
.vsconfig

Builds/

Content/Megascans/*
Content/Assets/*
/Content/Levels/_GENERATED
/Content/Cargo
/Imports
/CarnalAssets
env.json
AssetManager/pbprojectreset-sync-table.json
.idea
/Backup
/Sync/UnrealFlowSync/UnrealFlowSync/obj
/Sync/UnrealFlowSync/UnrealFlowSync/bin
.DS_Store
/Content/Sync/*
!/Content/Sync/dummy
/Content/Exec/*
!/Content/Exec/dummy
/Exec/UnrealFlowExec/UnrealFlowExec/bin
/Exec/UnrealFlowExec/UnrealFlowExec/obj
